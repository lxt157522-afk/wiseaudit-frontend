# ==========================================
# WiseAudit 前端环境变量
# ==========================================

# 后端API地址（必填）
# 开发时使用本地：http://localhost:3001
# 生产环境使用Render地址：https://your-backend.onrender.com
VITE_API_BASE=https://wiseaudit-backend.onrender.com

# Gemini API密钥（用于AI助手功能，可选）
VITE_GEMINI_API_KEY=your_gemini_api_key_here
